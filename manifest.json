{
  "manifest_version": 3,
  "name": "Capturas de Clase",
  "version": "1.0.0",
  "description": "Hace capturas periódicas de una pestaña (p. ej. Google Meet) y solo guarda las que cambian.",
  "action": {
    "default_title": "Capturas de Clase",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "116"
}
